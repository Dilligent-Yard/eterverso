{
  "name": "eterverso",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "start:ts": "ts-node src/server.ts",
    "dev": "node server.js",
    "dev:ts": "ts-node src/server.ts",
    "build": "npm run typecheck && npm run build:node && npm run build:client",
    "postinstall": "npm run build",
    "test:env:up": "node scripts/test-env.js up",
    "test:env:down": "node scripts/test-env.js down",
    "test:unit": "node scripts/test-runner.js unit",
    "test:integration": "node scripts/test-runner.js integration",
    "test:browser": "node scripts/test-runner.js browser",
    "test:all": "node scripts/test-runner.js all",
    "test": "node scripts/test-runner.js default",
    "db:preflight": "node scripts/db-migrate.js preflight",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.js migrate",
    "db:seed:timeline": "node scripts/seed-timeline.js",
    "db:studio": "drizzle-kit studio",
    "test:migration:populated": "node scripts/test-populated-migration.js --target=test",
    "wiki:authoring:compile": "node scripts/wiki-authoring-compile.js",
    "wiki:authoring:revision-plan": "node scripts/wiki-authoring-revision-plan.js",
    "wiki:sources:stage": "node scripts/wiki-source-stage.js stage",
    "wiki:sources:import": "node scripts/wiki-source-import.js",
    "public:fetch": "node scripts/public-snapshot-fetch.js",
    "public:sandbox": "node scripts/public-sandbox.js",
    "typecheck:legacy": "tsc --noEmit -p tsconfig.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:browser": "tsc --noEmit -p tsconfig.browser.json",
    "typecheck": "npm run typecheck:legacy && npm run typecheck:node && npm run typecheck:browser",
    "lint:typed": "eslint src/browser src/node",
    "check:js": "node scripts/check-js.js",
    "verify:static": "npm run typecheck && npm run build:node && npm run build:client && npm run lint:typed && npm run check:js && npm run --ignore-scripts test:unit",
    "build:node": "tsc -p tsconfig.node-build.json",
    "build:client": "esbuild src/browser/index.ts --bundle --format=iife --global-name=VaultModules --target=es2020 --outfile=generated/client/vault.js",
    "pretest:unit": "npm run build:node && npm run build:client",
    "pretest:browser": "npm run build:node && npm run build:client",
    "prestart": "node scripts/check-build.js",
    "predev": "node scripts/check-build.js",
    "pretest:integration": "npm run build:node",
    "pretest:all": "npm run build",
    "pretest": "npm run build",
    "predb:preflight": "npm run build:node",
    "predb:migrate": "npm run build:node",
    "prepublic:sandbox": "npm run build:node",
    "prepublic:fetch": "npm run build:node",
    "pretest:migration:populated": "npm run build:node"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-session": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "postgres": "^3.4.9",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-session": "^2.0.4",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.25.12",
    "eslint": "10.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.72.2"
  }
}
